# Workload node image (Phase 5): the e2e base image plus a CRI-enabled containerd
# and runc, so workloadagent can drive real CRI sandboxes inside a privileged
# container. Same containerd release the Ansible workload deploy installs (upstream
# *static* tarball — the plain one links glibc and will not run on this alpine
# base; the CRI plugin is built in). runc (static) is the default OCI runtime
# here; youki (the production default, static musl) is selected with
# E2E_OCI_RUNTIME=youki — phase 8 runs CDI device injection under both.
FROM kscale-e2e
ARG CONTAINERD_VERSION=2.3.2
ARG RUNC_VERSION=1.3.0
ARG YOUKI_VERSION=0.6.0
ADD https://github.com/containerd/containerd/releases/download/v${CONTAINERD_VERSION}/containerd-static-${CONTAINERD_VERSION}-linux-amd64.tar.gz /tmp/containerd.tgz
ADD https://github.com/opencontainers/runc/releases/download/v${RUNC_VERSION}/runc.amd64 /usr/local/bin/runc
ADD https://github.com/youki-dev/youki/releases/download/v${YOUKI_VERSION}/youki-${YOUKI_VERSION}-x86_64-musl.tar.gz /tmp/youki.tgz
RUN tar -xzf /tmp/containerd.tgz -C /usr/local && rm /tmp/containerd.tgz && chmod 0755 /usr/local/bin/runc \
 && tar -xzf /tmp/youki.tgz -C /usr/local/bin youki && rm /tmp/youki.tgz && chmod 0755 /usr/local/bin/youki
# bpftool: read the workload datapath's counters in phase 6.
RUN apk add --no-cache bpftool
COPY workload-entrypoint.sh /usr/local/bin/workload-entrypoint.sh
ENTRYPOINT ["/bin/sh", "/usr/local/bin/workload-entrypoint.sh"]
