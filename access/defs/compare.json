{
    "precompile": [
        {
            "name": "timePrecompile",
            "go_type": "time.Time",
            "placeholder": "$1",
            "method": "time.Parse(time.RFC3339, $1)"
        },
        {
            "name": "durationPrecompile",
            "go_type": "time.Duration",
            "placeholder": "$1",
            "method": "time.ParseDuration($1)"
        },
        {
            "name": "timePrecompile",
            "go_type": "time.Time",
            "placeholder": "$1",
            "method": "time.Parse(time.RFC3339, $1)"
        },
        {
            "name": "stringSetPrecompile",
            "go_type": "map[string]struct{}",
            "placeholder": "$1",
            "method": "makeStringSet($1)"
        },
        {
            "name": "regexPrecompile",
            "go_type": "*regexp.Regexp",
            "placeholder": "$1",
            "method": "regexp.Compile($1)"
        },
        {
            "name": "ipPrecompile",
            "go_type": "netip.Addr",
            "placeholder": "$1",
            "method": "netip.ParseAddr($1)"
        },
        {
            "name": "cidrPrecompile",
            "go_type": "netip.Prefix",
            "placeholder": "$1",
            "method": "netip.ParsePrefix($1)"
        }
