            "//_category": "=== STRING OPERATORS ===",
            "id": "StringEquals",
            "alias": [
                "string_equal",
                "str_eq"
            ],
            "description": "文字列の完全一致",
            "target_go_type": "string",
            "imports": [],
            "arguments": [
                {
                    "placeholder": "$1",
                    "go_type": "string",
                    "name": "value"
                }
            ],
            "logic_expression": "$Target == $1"
        },
        {
            "id": "StringNotEquals",
            "alias": [
                "string_not_equal",
                "str_neq"
            ],
            "description": "文字列の不一致",
