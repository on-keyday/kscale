{
    "name": "InterfaceMonitor",
    "policy": "Allow",
    "description": "Read-only monitoring access for the nodewatch agent's `monitor` role.",
    "resource": "interface",
    "action": [
        "list",
        "get"
    ],
    "or": [
        {
            "name": "CanInterfaceMonitor",
            "and": [
                {
                    "name": "UserAuthorityIsManager",
                    "condition": "$user.authority.full_name suffix $env.authority.admin.ca.manager."
                },
                {
                    "name": "UserHasMonitorRole",
                    "condition": "$user.roles list_contains `monitor`"
                }
            ]
        }
    ]
}
