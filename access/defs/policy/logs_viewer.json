{
    "name": "LogsViewer",
    "policy": "Allow",
    "resource": "logs",
    "action": [
        "stream",
        "tail"
    ],
    "or": [
        {
            "name": "CanViewLogs",
            "description": "Demo grants the CA-manager admin; the real owner is the dataplane/log manager.",
            "and": [
                {
                    "name": "UserAuthorityIsManager",
                    "condition": "$user.authority.full_name suffix $env.authority.admin.ca.manager."
                },
                {
                    "name": "UserHasRequiredRole",
                    "or": [
                        {
                            "name": "HumanUserHasManagementRole",
                            "condition": "$user.roles list_contains `admin`"
                        }
                    ]
                }
            ]
        }
    ]
}
