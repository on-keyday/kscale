{
    "name": "AcmeManager",
    "policy": "Allow",
    "resource": "acme",
    "action": [
        "obtain",
        "list",
        "get-cert",
        "delete-cert",
        "delete-account"
    ],
    "or": [
        {
            "name": "CanManageAcme",
            "description": "Demo grants the CA-manager admin; the real owner is the dataplane/cert manager.",
            "and": [
                {
                    "name": "UserAuthorityIsManager",
                    "condition": "$user.authority.full_name suffix $env.authority.admin.ca.manager."
                },
                {
                    "name": "UserHasRequiredRole",
                    "or": [
                        {
                            "name": "HumanUserHasManagementRole",
                            "condition": "$user.roles list_contains `admin`"
                        }
                    ]
                }
            ]
        }
    ]
}
