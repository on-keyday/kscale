{
    "name": "OpenPortMonitor",
    "policy": "Allow",
    "description": "Read-only monitoring access for the nodewatch agent's `monitor` role, including diff (a read-only dry query of actual router ACL vs desired open-port drift).",
    "resource": "open_port",
    "action": [
        "list",
        "get",
        "diff"
    ],
    "or": [
        {
            "name": "CanOpenPortMonitor",
            "and": [
                {
                    "name": "UserAuthorityIsManager",
                    "condition": "$user.authority.full_name suffix $env.authority.admin.ca.manager."
                },
                {
                    "name": "UserHasMonitorRole",
                    "condition": "$user.roles list_contains `monitor`"
                }
            ]
        }
    ]
}
