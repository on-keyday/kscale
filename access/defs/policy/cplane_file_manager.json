{
    "name": "CplaneFileManager",
    "policy": "Allow",
    "resource": "cplane_file",
    "action": ["upload", "list", "delete"],
    "or": [
        {
            "name": "CanManageCplaneFiles",
            "description": "Demo grants the CA-manager admin.",
            "and": [
                {
                    "name": "UserAuthorityIsManager",
                    "condition": "$user.authority.full_name suffix $env.authority.admin.ca.manager."
                },
                {
                    "name": "UserHasRequiredRole",
                    "or": [
                        {"name": "HumanUserHasManagementRole", "condition": "$user.roles list_contains `admin`"}
                    ]
                }
            ]
        }
    ]
}
