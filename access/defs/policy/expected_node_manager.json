{
    "name": "ExpectedNodeManager",
    "policy": "Allow",
    "description": "Manage the declared node inventory (advisory; derived from the deploy config).",
    "resource": "expected_node",
    "action": [
        "apply",
        "list",
        "get",
        "delete"
    ],
    "or": [
        {
            "name": "CanManageExpectedNodes",
            "and": [
                {
                    "name": "UserAuthorityIsManager",
                    "condition": "$user.authority.full_name suffix $env.authority.admin.ca.manager."
                },
                {
                    "name": "UserHasRequiredRole",
                    "or": [
                        {
                            "name": "HumanUserHasManagementRole",
                            "condition": "$user.roles list_contains `admin`"
                        }
                    ]
                }
            ]
        }
    ]
}
