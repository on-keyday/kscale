        }
    ],
    "prometheus_converts": [
        {
            "name": "instance",
            "convert": "$self.CommonName"
        },
        {
            "name": "interface",
            "convert": "func() string { if i < len($self.Interfaces) { return $self.Interfaces[i] } else { return \"unknown\" } }()"
        }
    ]
}