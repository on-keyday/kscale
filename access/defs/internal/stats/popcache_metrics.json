{
    "prometheus": [
        {
            "metric_name": "ksdk_popcache_requests_total",
            "help": "Popcache metric requests_total",
            "long_name": "PopcacheRequestsTotal",
            "value_type": "counter",
            "hold_type": "uint64",
            "source_metric": "popcache_stats",
            "optional": true,
            "optional_condtition": "$self.PopcacheEnabled",
            "to_prometheus": "$dst = uint64($src.RequestsTotal)",
            "labels": [
                {
                    "name": "instance"
                }
            ]
        },
        {
            "metric_name": "ksdk_popcache_requests_end_total",
            "help": "Popcache metric requests_end_total",
